    "details": {
      "biography": {
        "value": "<h2>Quillibus “Quill” Scratch</h2><p><strong>Occupation:</strong> Runecrafter, repairman, inscription copyist, and reluctant municipal contractor.</p><p><strong>Training role:</strong> Stellan's practical low-level Runecraft trainer. He teaches grammar, diagnosis, and legitimate glyph study without granting free Rune Charges.</p><p><strong>Combat:</strong> Civilian craftsperson. His safest combat technique is standing behind Exchange security while explaining why the attacker used the wrong door.</p>",
        "public": "<p>A skeleton in a craftsman's coat sits behind a counter covered in carved tiles, wax impressions, chalk, chisels, and labeled anchor materials. Tiny inscriptions run along several of his own bones.</p><p><strong>Quillibus “Quill” Scratch</strong><br>Runecrafter</p>"
      },
      "alignment": "",
      "race": null,
      "type": {
        "value": "undead",
        "subtype": "sentient skeletal runecrafter",
        "swarm": "",
        "custom": ""
      },
      "cr": 0.5,
      "ideal": "An instruction should mean exactly one thing before anyone is permitted to bleed near it.",
      "bond": "His shop, his surviving fingers, and the grammatical integrity of local inscriptions.",
      "flaw": "Treats every conversation as if someone may later attempt to Countermark it.",
