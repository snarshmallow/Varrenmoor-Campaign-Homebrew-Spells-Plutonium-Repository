    {
      "_id": "7ec3328381c1b546",
      "name": "Merchant Reference: Haddo's Stock",
      "type": "feat",
      "img": "icons/sundries/documents/document-sealed-red-yellow.webp",
      "system": {
        "description": {
          "value": "<h2>Haddo's Stock</h2><ul><li>Hemp rope (50 ft): 1 gp</li><li>Silk cord (50 ft): 10 gp</li><li>Trolley cable offcuts: ask</li><li>Iron bar stock: 5 sp each (two are Hunger-tainted; he doesn't know)</li><li>Splicing fids</li><li>Pulleys: 1 gp</li><li>Harness: 2 gp</li></ul><p><strong>Refusals:</strong> he will not sell a rope he has not tested, and will not say where any line he braids is going (he doesn't know).</p>",
          "chat": ""
        },
