    {
      "_id": "dd3366a6776af959",
      "name": "GM Reference: Lil' Apostrophe at the Night Desk",
      "type": "feat",
      "img": "icons/sundries/documents/document-sealed-red-yellow.webp",
      "system": {
        "description": {
          "value": "<h2>Lil' Apostrophe at the Night Desk</h2><p>Sabeline: <em>\"Please don't write on my ledger.\"</em> Lil: <em>\"I wasn't gonna. ...What's it say if I did?\"</em></p><p>Lil: <em>\"Is the ledger a book that's awake at night?\"</em> Sabeline: <em>\"Yes.\"</em> Lil: <em>\"Same.\"</em></p>",
          "chat": ""
