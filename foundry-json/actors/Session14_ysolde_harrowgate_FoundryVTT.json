    {
      "_id": "f8d006f245a06d51",
      "name": "Merchant Reference: Harrowgate's Counter",
      "type": "feat",
      "img": "icons/sundries/documents/document-sealed-red-yellow.webp",
      "system": {
        "description": {
          "value": "<h2>Harrowgate's Counter</h2><ul><li>Clean burial linen: 5 sp per yard</li><li>Distilled water: 2 sp per flask</li><li>Joining needles and bone-thread: 1 gp</li><li>Identity tag blanks: 1 sp</li><li>Preserving salts: 5 sp</li><li>Restoration consultations: 5 gp (written)</li><li>Restoration contracts: by quote, no guarantees</li></ul><p><strong>Refusals:</strong> she does not sell bodies over the counter, and does not sell anything that \"was ever someone\".</p>",
          "chat": ""
