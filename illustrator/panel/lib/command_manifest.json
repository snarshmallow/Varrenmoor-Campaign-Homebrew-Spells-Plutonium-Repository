  },
  "bridge.ps1": {
   "cli_only": "developer shell for raw bridge calls (ping, get, create) from a terminal or a Claude session; the panel talks to the bridge through the commands above"
  },
  "make-scene.ps1": {
   "cli_only": "older one-model scene maker, replaced by Push models / Push whole 3D scene"
  },
  "publish-client.mjs": {
